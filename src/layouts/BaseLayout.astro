---
/**
 * Layout de base : squelette HTML, métadonnées, en-tête et pied de page.
 * Toutes les pages s'appuient dessus.
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Seo, { type PageType } from '../components/Seo.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { absoluteUrl, markdownTwinPathname, robotsDirective } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  /** Nature de la page — pilote og:type et le nœud schema.org. */
  type?: PageType;
  /** Contenu non-substantiel (page « en préparation ») : exclu de l'index. */
  noindex?: boolean;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title, description, type = 'website', noindex = false } = Astro.props;
const pageTitle = title ? `${title} — ${t('site.title')}` : `${t('site.title')} — ${t('site.tagline')}`;
const pageDescription = description ?? t('site.description');
const base = import.meta.env.BASE_URL;
const markdownTwinUrl = absoluteUrl(markdownTwinPathname(Astro.url.pathname, base, lang), Astro.site);
// `BASE_URL` n'a pas forcément de `/` final (ex. déploiement GitHub Pages
// sous /system-g, sans slash) : on le retire puis on le rajoute nous-mêmes,
// pour ne pas obtenir un chemin collé du type `/system-gfavicon.svg`.
const assetBase = base.replace(/\/$/, '');
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="robots" content={robotsDirective(noindex)} />
    <meta name="author" content={t('bio.title')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#7a2e2e" />
    {!noindex && <link rel="alternate" type="text/markdown" href={markdownTwinUrl} />}
    <link rel="icon" href={`${assetBase}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${assetBase}/favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="icon" href={`${assetBase}/favicon-16.png`} sizes="16x16" type="image/png" />
    <link rel="icon" href={`${assetBase}/favicon.ico`} sizes="48x48" />
    <link rel="apple-touch-icon" href={`${assetBase}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${assetBase}/site.webmanifest`} />

    <Seo pageTitle={pageTitle} pageDescription={pageDescription} type={type} />
    <SchemaOrg pageTitle={pageTitle} pageDescription={pageDescription} type={type} />
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skipToContent')}</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
