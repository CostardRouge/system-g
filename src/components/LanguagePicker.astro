---
/**
 * Sélecteur de langue. Bascule entre le français (racine), l'anglais (/en/)
 * et l'italien (/it/) en conservant la page courante — y compris quand son
 * adresse est traduite (src/lib/slugs.ts) : le chemin neutre est recalculé
 * par les mêmes utilitaires que les balises hreflang.
 */
import { getLangFromUrl, listLanguages, type Lang } from '../i18n/utils';
import { localizedPathname, neutralPath } from '../lib/seo';

const currentLang = getLangFromUrl(Astro.url);
const langs = listLanguages();

const base = import.meta.env.BASE_URL;
const neutral = neutralPath(Astro.url.pathname, base);

function hrefFor(lang: Lang): string {
  return localizedPathname(neutral, lang, base);
}
---

<nav class="lang-picker" aria-label="Language selection">
  {
    langs.map(([code, label], i) => (
      <>
        {i > 0 && <span class="lang-picker__sep" aria-hidden="true">·</span>}
        <a
          href={hrefFor(code)}
          lang={code}
          aria-current={code === currentLang ? 'true' : undefined}
          title={label}
        >
          {code.toUpperCase()}
        </a>
      </>
    ))
  }
</nav>
